@model KTBEE_NguyenHoangAnh.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

@section styles {
    <style>
        .customer-login {
            max-width: 420px;
            margin: 45px auto;
            padding: 32px;
            border: 1px solid #e5dfd5;
            border-radius: 12px;
            background: white;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
        }

            .customer-login h1 {
                margin-bottom: 10px;
                font-size: 28px;
                font-weight: 600;
                text-align: center;
            }

        .customer-login-intro {
            margin-bottom: 28px;
            color: #777;
            font-size: 14px;
            text-align: center;
        }

        .customer-login .form-label {
            font-size: 14px;
        }

        .customer-login .form-control {
            padding: 12px 14px;
            border-color: #ded6c8;
            border-radius: 7px;
        }

            .customer-login .form-control:focus {
                border-color: #b28b50;
                box-shadow: 0 0 0 3px rgba(178, 139, 80, 0.12);
            }

        .customer-login .lux-button {
            width: 100%;
            margin-top: 8px;
            padding: 12px;
        }

        .customer-login-register {
            margin: 24px 0 0;
            color: #777;
            font-size: 14px;
            text-align: center;
        }

            .customer-login-register a {
                color: #806133;
                font-weight: 600;
            }

        @@media (max-width: 480px) {
            .customer-login {
                margin: 20px auto;
                padding: 24px;
            }
        }
    </style>
}

<div class="customer-login">
    <h1>Đăng nhập</h1>

    <p class="customer-login-intro">
        Chào mừng bạn trở lại LuxuryAuto
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    }

    @using (Html.BeginForm(
        "Login",
        "Account",
        new { area = "" },
        FormMethod.Post,
        new { @class = "customer-login-form" }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(
                 true,
                 "",
                 new { @class = "text-danger mb-3", role = "alert" })

        <div class="mb-3">
            @Html.LabelFor(
                     m => m.Username,
                     "Tên đăng nhập",
                     new { @class = "form-label" })

            @Html.TextBoxFor(
                     m => m.Username,
                     new
                     {
                         @class = "form-control",
                         placeholder = "Nhập tên đăng nhập",
                         autocomplete = "section-customer username"
                     })

            @Html.ValidationMessageFor(
                     m => m.Username,
                     "",
                     new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(
                     m => m.Password,
                     "Mật khẩu",
                     new { @class = "form-label" })

            @Html.PasswordFor(
                     m => m.Password,
                     new
                     {
                         @class = "form-control",
                         placeholder = "Nhập mật khẩu",
                         autocomplete = "section-customer current-password"
                     })

            @Html.ValidationMessageFor(
                     m => m.Password,
                     "",
                     new { @class = "text-danger small" })
        </div>

        <button type="submit" class="lux-button">
            Đăng nhập
        </button>
    }

    <p class="customer-login-register">
        Chưa có tài khoản?
        <a href="@Url.Action("Register", "Account", new { area = "" })">
            Đăng ký ngay
        </a>
    </p>
</div>