@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Tạo tài khoản Admin - LuxuryAuto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/LuxuryAuto/AdminLogin.css")"
          rel="stylesheet" />
</head>

<body>
    <main class="admin-login-page">
        <div class="admin-login-card">
            <div class="admin-login-header">
                <a class="admin-login-brand"
                   href="@Url.Action("Index", "Home", new { area = "" })">
                    Luxury<span>Auto</span>
                </a>

                <div class="admin-login-label">
                    TRANG QUẢN TRỊ
                </div>

                <h1>Tạo tài khoản Admin</h1>

                <p>Nhập thông tin để tạo tài khoản quản trị.</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger small" role="alert">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm(
                "CreateAdmin",
                "Account",
                new { area = "" },
                FormMethod.Post,
                new { @class = "admin-login-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="username" class="form-label">
                        Tên đăng nhập
                    </label>

                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control"
                           placeholder="Nhập tên đăng nhập"
                           autocomplete="section-admin-register username"
                           minlength="4"
                           required />

                    <div class="form-text">
                        Tối thiểu 4 ký tự.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">
                        Mật khẩu
                    </label>

                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           autocomplete="section-admin-register new-password"
                           minlength="8"
                           required />

                    <div class="form-text">
                        Tối thiểu 8 ký tự.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label">
                        Nhập lại mật khẩu
                    </label>

                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="form-control"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="section-admin-register new-password"
                           minlength="8"
                           required />
                </div>

                <button type="submit" class="admin-login-submit">
                    Tạo tài khoản Admin
                </button>
            }

            <div class="admin-login-links">
                <a href="@Url.Action("Login", "Account", new { area = "Admin" })">
                    ← Quay lại đăng nhập Admin
                </a>

                <a href="@Url.Action("Index", "Home", new { area = "" })">
                    Về trang khách hàng
                </a>
            </div>
        </div>

        <p class="admin-login-footer">
            &copy; @DateTime.Now.Year LuxuryAuto
        </p>
    </main>

    <script>var password = document.getElementById("password");
        var confirmPassword = document.getElementById("confirmPassword");

        function checkPasswords() {
            confirmPassword.setCustomValidity(
                confirmPassword.value &&
                confirmPassword.value !== password.value
                    ? "Mật khẩu nhập lại không khớp."
                    : ""
            );
        }

        password.addEventListener("input", checkPasswords);
        confirmPassword.addEventListener("input", checkPasswords);</script>
</body>
</html>