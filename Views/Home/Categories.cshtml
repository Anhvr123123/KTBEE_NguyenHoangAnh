
@model IEnumerable<KTBEE_NguyenHoangAnh.Models.Product>
@using System
@using System.Linq

@{
    ViewBag.Title = "Danh sách xe";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>Danh sách xe @ViewBag.CategoryName</h2>
<hr />

<div class="row">
    @foreach (var item in Model)
    {
        string imageUrl = "";

        if (!string.IsNullOrWhiteSpace(item.ProductImage))
        {
            string image = item.ProductImage.Trim();

            if (image.StartsWith("https://",
                StringComparison.OrdinalIgnoreCase) ||
                image.StartsWith("http://",
                StringComparison.OrdinalIgnoreCase))
            {
                imageUrl = image;
            }
            else if (image.StartsWith("~/"))
            {
                imageUrl = Url.Content(image);
            }
            else if (image.StartsWith("/"))
            {
                imageUrl = image;
            }
            else
            {
                imageUrl = Url.Content(
                    "~/Images/cars/" + image);
            }
        }

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">

                <div style="height:220px;background:#f5f5f5;">
                    @if (!string.IsNullOrEmpty(imageUrl))
                    {
                        <img src="@imageUrl"
                             class="card-img-top"
                             style="width:100%;height:220px;object-fit:cover;"
                             alt="@item.ProductName" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                            Chưa có ảnh xe
                        </div>
                    }
                </div>

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        @item.ProductName
                    </h5>

                    <p>
                        Năm sản xuất:
                        @item.ModelYear
                    </p>

                    <p>
                        Màu sắc:
                        @item.CarColor
                    </p>

                    <p>
                        Động cơ:
                        @item.Engine
                    </p>

                    <p class="text-danger fw-bold">
                        @String.Format("{0:N0}", item.ProductPrice) VNĐ
                    </p>

                    <div class="mt-auto">
                        <a href="@Url.Action(
                                     "Details",
                                     "Home",
                                     new { id = item.ProductID })"
                           class="btn btn-primary">
                            Xem chi tiết
                        </a>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Chưa có xe thuộc hãng này.
    </div>
}

<a href="@Url.Action("Index", "Home")"
   class="btn btn-secondary mt-3">
    Quay lại trang chủ
</a>
