@using System
@using System.Linq
@using System.Collections.Generic
@using KTBEE_NguyenHoangAnh.Models

@{
    Layout = null;

    string username = Convert.ToString(Session["Username"]);
    bool isLoggedIn = !string.IsNullOrWhiteSpace(username);

    var cart = Session["Cart"] as List<CartItem>;
    int cartCount = cart == null ? 0 : cart.Sum(x => x.Quantity);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - LuxuryAuto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="~/Content/LuxuryAuto/CustomerLayout.css" rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>

<body>
    <header class="lux-navbar">
        <div class="container lux-nav-inner">
            <a class="lux-brand"
               href="@Url.Action("Index", "Home", new { area = "" })">
                Luxury<span>Auto</span>
            </a>

            <nav class="lux-navigation"
                 aria-label="Điều hướng chính">

                <ul class="lux-links">
                    <li>
                        <a class="lux-nav-link"
                           href="@Url.Action("Index", "Home", new { area = "" })">
                            Trang chủ
                        </a>
                    </li>

                    <li class="lux-category">
                        <button type="button"
                                class="lux-nav-link lux-category-toggle"
                                aria-controls="categoryMenu">
                            Danh mục
                        </button>

                        <div class="lux-category-menu" id="categoryMenu">
                            <a href="@Url.Action("Category", "Home",
                         new { area = "", id = 1 })">
                                Porsche
                            </a>

                            <a href="@Url.Action("Category", "Home",
                         new { area = "", id = 2 })">
                                BMW
                            </a>
                        </div>
                    </li>
                    <li>
                        <a class="lux-nav-link"
                           href="@Url.Action("Index", "MyOrders", new { area = "" })">
                            Đơn hàng
                        </a>
                    </li>
                </ul>

                <div class="lux-actions">
                    <a class="lux-cart"
                       href="@Url.Action("Index", "Cart", new { area = "" })">
                        Giỏ hàng
                        <span class="lux-count">@cartCount</span>
                    </a>

                    @if (!isLoggedIn)
                    {
                        <a class="lux-nav-link"
                           href="@Url.Action("Login", "Account",
                               new { area = "" })">
                            Đăng nhập
                        </a>

                        <a class="lux-button lux-register"
                           href="@Url.Action("Register", "Account",
                               new { area = "" })">
                            Đăng ký
                        </a>
                    }
                    else
                    {
                        <div class="customer-account">
                            <button type="button"
                                    class="customer-account-name"
                                    aria-controls="customerAccountMenu">
                                <span>@username</span>
                                <span class="customer-account-arrow">▾</span>
                            </button>

                            <div class="customer-account-menu"
                                 id="customerAccountMenu">

                                <a class="customer-info-button"
                                   href="@Url.Action("Index", "CustomerProfile",
                                       new { area = "" })">
                                    Thông tin khách hàng
                                </a>

                                @using (Html.BeginForm(
                                    "Logout",
                                    "Account",
                                    new { area = "" },
                                    FormMethod.Post,
                                    new { @class = "customer-logout-form" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="customer-logout-button">
                                        Đăng xuất
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main class="container lux-main">
        @RenderBody()
    </main>

    <footer class="lux-footer">
        <div class="container lux-footer-inner">
            <div>
                <a class="lux-footer-brand"
                   href="@Url.Action("Index", "Home", new { area = "" })">
                    LuxuryAuto
                </a>

                <div class="mt-2">
                    Khám phá bộ sưu tập Porsche & BMW.
                </div>
            </div>

            <div>
                &copy; @DateTime.Now.Year LuxuryAuto.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>