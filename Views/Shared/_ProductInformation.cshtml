@model KTBEE_NguyenHoangAnh.Models.Product
@using System
@using System.Linq
@using System.Globalization

@{
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var stock = Model.ProductDetails
        .OrderBy(d => d.ProductDetailID)
        .FirstOrDefault();

    int available = stock == null
        ? 0
        : Math.Max(0, stock.Quantity - stock.QuantitySold);

    string imageUrl = "";

    if (!string.IsNullOrWhiteSpace(Model.ProductImage))
    {
        string image = Model.ProductImage.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = image;
        }
        else if (image.StartsWith("~/"))
        {
            imageUrl = Url.Content(image);
        }
        else if (image.StartsWith("/"))
        {
            imageUrl = image;
        }
        else
        {
            imageUrl = Url.Content("~/Images/cars/" + image);
        }
    }
}

<div class="product-info">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="product-info-photo">
                @if (!string.IsNullOrWhiteSpace(imageUrl))
                {
                    <img src="@imageUrl"
                         alt="@Model.ProductName"
                         onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />

                    <span hidden>Đang cập nhật ảnh</span>
                }
                else
                {
                    <span>Đang cập nhật ảnh</span>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="product-info-brand">
                @(Model.Category != null
                    ? Model.Category.CategoryName
                    : "LuxuryAuto")
            </div>

            <h1 class="product-info-title">@Model.ProductName</h1>

            <div class="product-info-price">
                @string.Format(vi, "{0:N0}", Model.ProductPrice) VNĐ
            </div>

            <dl class="product-info-specs mb-0">
                <div>
                    <dt>Năm sản xuất</dt>
                    <dd>
                        @(Model.ModelYear.HasValue
                            ? Model.ModelYear.Value.ToString()
                            : "Đang cập nhật")
                    </dd>
                </div>

                <div>
                    <dt>Màu sắc</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(Model.CarColor)
                            ? "Đang cập nhật"
                            : Model.CarColor)
                    </dd>
                </div>

                <div>
                    <dt>Động cơ</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(Model.Engine)
                            ? "Đang cập nhật"
                            : Model.Engine)
                    </dd>
                </div>

                <div>
                    <dt>Hộp số</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(Model.Transmission)
                            ? "Đang cập nhật"
                            : Model.Transmission)
                    </dd>
                </div>

                <div>
                    <dt>Còn trong kho</dt>
                    <dd>@available xe</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="product-info-description">
        <h3>Mô tả xe</h3>
        <p>@(string.IsNullOrWhiteSpace(Model.ProductDescription) ? "Thông tin đang được cập nhật." : Model.ProductDescription.Trim())</p>
    </div>
</div>