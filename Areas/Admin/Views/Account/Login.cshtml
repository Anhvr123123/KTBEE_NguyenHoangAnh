@model KTBEE_NguyenHoangAnh.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Đăng nhập Admin - LuxuryAuto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="~/Content/LuxuryAuto/AdminLogin.css" rel="stylesheet" />
</head>

<body>
    <main class="admin-login-page">
        <div class="admin-login-card">
            <div class="admin-login-header">
                <a class="admin-login-brand"
                   href="@Url.Action("Index", "Home", new { area = "" })">
                    Luxury<span>Auto</span>
                </a>

                <div class="admin-login-label">TRANG QUẢN TRỊ</div>

                <h1>Đăng nhập Admin</h1>
                <p>Sử dụng tài khoản quản trị để tiếp tục.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success small" role="alert">
                    @TempData["Success"]
                </div>
            }

            @using (Html.BeginForm(
                "Login",
                "Account",
                new { area = "Admin" },
                FormMethod.Post,
                new { @class = "admin-login-form" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                         true,
                         "",
                         new { @class = "admin-login-errors", role = "alert" })

                <div class="mb-3">
                    @Html.LabelFor(
                             m => m.Username,
                             "Tên đăng nhập",
                             new { @class = "form-label" })

                    @Html.TextBoxFor(
                             m => m.Username,
                             new
                             {
                                 @class = "form-control",
                                 placeholder = "Nhập tên đăng nhập",
                                 autocomplete = "section-admin username",
                                 required = "required"
                             })

                    @Html.ValidationMessageFor(
                             m => m.Username,
                             "",
                             new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(
                             m => m.Password,
                             "Mật khẩu",
                             new { @class = "form-label" })

                    @Html.PasswordFor(
                             m => m.Password,
                             new
                             {
                                 @class = "form-control",
                                 placeholder = "Nhập mật khẩu",
                                 autocomplete = "section-admin current-password",
                                 required = "required"
                             })

                    @Html.ValidationMessageFor(
                             m => m.Password,
                             "",
                             new { @class = "text-danger small" })
                </div>

                <button type="submit" class="admin-login-submit">
                    Đăng nhập
                </button>
            }

            <div class="admin-login-links">
                <a href="@Url.Action("CreateAdmin", "Account", new { area = "" })">
                    Tạo tài khoản Admin
                </a>

                <a href="@Url.Action("Index", "Home", new { area = "" })">
                     Về trang khách hàng
                </a>
            </div>
        </div>

        <p class="admin-login-footer">
            &copy; @DateTime.Now.Year LuxuryAuto
        </p>
    </main>
</body>
</html>