
@model KTBEE_NguyenHoangAnh.Models.AdminRegisterViewModel

@{
    ViewBag.Title = "Đăng ký Admin";
    Layout = null;
}


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Đăng ký Admin - LuxuryAuto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #101827, #253650);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .register-box {
            width: 100%;
            max-width: 460px;
            background: white;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(0,0,0,.25);
        }

        .brand {
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            color: #17243a;
        }

            .brand span {
                color: #d7a33c;
            }
    </style>
</head>

<body>
    <div class="register-box">

        <div class="brand">
            Luxury<span>Auto</span>
        </div>

        <h4 class="text-center mt-2 mb-3">
            Đăng ký tài khoản Admin
        </h4>

        <p class="text-muted text-center">
            Chỉ quản trị viên đã đăng nhập được tạo Admin mới.
        </p>

        @using (Html.BeginForm(
            "Register",
            "Account",
            new { area = "Admin" },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                          false, "", new { @class = "text-danger" })

            <div class="mb-3">
                <label class="form-label">
                    Tên đăng nhập
                </label>

                @Html.TextBoxFor(m => m.Username,
                              new
                              {
                                  @class = "form-control",
                                  placeholder = "Nhập tên đăng nhập"
                              })

                @Html.ValidationMessageFor(
                              m => m.Username, "",
                              new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Mật khẩu
                </label>

                @Html.PasswordFor(m => m.Password,
                              new
                              {
                                  @class = "form-control",
                                  placeholder = "Nhập mật khẩu"
                              })

                @Html.ValidationMessageFor(
                              m => m.Password, "",
                              new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Nhập lại mật khẩu
                </label>

                @Html.PasswordFor(m => m.ConfirmPassword,
                              new
                              {
                                  @class = "form-control",
                                  placeholder = "Nhập lại mật khẩu"
                              })

                @Html.ValidationMessageFor(
                              m => m.ConfirmPassword, "",
                              new { @class = "text-danger" })
            </div>

            <button type="submit"
                    class="btn btn-dark w-100">
                Tạo tài khoản Admin
            </button>
        }

        <div class="text-center mt-3">
            <a href="@Url.Action(
                "Index", "Admin", new { area = "Admin" })">
                Quay lại trang quản trị
            </a>
        </div>

    </div>
</body>
</html>
