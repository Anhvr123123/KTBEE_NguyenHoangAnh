@model KTBEE_NguyenHoangAnh.Models.AdminUserViewModel

@{
    bool isCreate = ViewBag.IsCreate == true;

    string actionName = isCreate ? "Create" : "Edit";

    ViewBag.Title = isCreate
        ? "Thêm tài khoản Admin"
        : "Sửa tài khoản Admin";

    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <h2>@ViewBag.Title</h2>

                <p class="text-muted">
                    @(isCreate
                        ? "Nhập thông tin tài khoản quản trị mới."
                        : "Để trống cả hai ô mật khẩu nếu không muốn đổi.")
                </p>

                @using (Html.BeginForm(
                    actionName,
                    "AdminUsers",
                    new { area = "Admin" },
                    FormMethod.Post,
                    new { @class = "mt-4" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                             true,
                             "",
                             new { @class = "text-danger mb-3" })

                    if (!isCreate)
                    {
                        <input type="hidden"
                               name="originalUsername"
                               value="@Model.Username" />
                    }

                    <div class="mb-3">
                        @Html.LabelFor(
                                 m => m.Username,
                                 new { @class = "form-label" })

                        @if (isCreate)
                        {
                            @Html.TextBoxFor(
                                     m => m.Username,
                                     new
                                     {
                                         @class = "form-control",
                                         minlength = "4",
                                         maxlength = "50",
                                         required = "required",
                                         autocomplete = "off"
                                     })
                        }
                        else
                        {
                            @Html.TextBoxFor(
                                     m => m.Username,
                                     new
                                     {
                                         @class = "form-control",
                                         @readonly = "readonly"
                                     })

                            <div class="form-text">
                                Tên đăng nhập được giữ nguyên.
                            </div>
                        }

                        @Html.ValidationMessageFor(
                                 m => m.Username,
                                 "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(
                                 m => m.Password,
                                 isCreate ? "Mật khẩu" : "Mật khẩu mới",
                                 new { @class = "form-label" })

                        @Html.PasswordFor(
                                 m => m.Password,
                                 new
                                 {
                                     @class = "form-control",
                                     minlength = "8",
                                     maxlength = "100",
                                     autocomplete = "new-password"
                                 })

                        @Html.ValidationMessageFor(
                                 m => m.Password,
                                 "",
                                 new { @class = "text-danger small" })

                        <div class="form-text">
                            Từ 8 đến 100 ký tự.
                        </div>
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(
                                 m => m.ConfirmPassword,
                                 new { @class = "form-label" })

                        @Html.PasswordFor(
                                 m => m.ConfirmPassword,
                                 new
                                 {
                                     @class = "form-control",
                                     minlength = "8",
                                     maxlength = "100",
                                     autocomplete = "new-password"
                                 })

                        @Html.ValidationMessageFor(
                                 m => m.ConfirmPassword,
                                 "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-success">
                            @(isCreate ? "Tạo tài khoản" : "Lưu thay đổi")
                        </button>

                        <a class="btn btn-outline-secondary"
                           href="@Url.Action("Index", "AdminUsers",
                               new { area = "Admin" })">
                            Quay lại
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>