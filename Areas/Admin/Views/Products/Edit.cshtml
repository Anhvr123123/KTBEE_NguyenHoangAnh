
@model KTBEE_NguyenHoangAnh.Models.Product

@{
    ViewBag.Title = "Sửa thông tin xe";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4 mb-5">

    <h2>Sửa thông tin xe</h2>
    <hr />

    @using (Html.BeginForm(
        "Edit",
        "Products",
        new { area = "Admin" },
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ProductID)

        @Html.ValidationSummary(false, "",
                new { @class = "text-danger" })

        <div class="mb-3">
            <label class="form-label">Mã xe</label>
            <input type="text"
                   class="form-control"
                   value="@Model.ProductID"
                   readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Tên xe</label>

            @Html.TextBoxFor(m => m.ProductName,
                          new
                          {
                              @class = "form-control",
                              required = "required"
                          })

            @Html.ValidationMessageFor(
                          m => m.ProductName, "",
                          new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">Hãng xe</label>

            @Html.DropDownListFor(
                          m => m.CategoryID,
                          (SelectList)ViewBag.CategoryID,
                          "-- Chọn hãng xe --",
                          new { @class = "form-select" })

            @Html.ValidationMessageFor(
                          m => m.CategoryID, "",
                          new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">Giá bán (VNĐ)</label>

            @Html.TextBoxFor(m => m.ProductPrice,
                          new
                          {
                              @class = "form-control",
                              type = "number",
                              min = "1",
                              step = "1"
                          })

            @Html.ValidationMessageFor(
                          m => m.ProductPrice, "",
                          new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">Năm sản xuất</label>

            @Html.TextBoxFor(m => m.ModelYear,
                          new
                          {
                              @class = "form-control",
                              type = "number",
                              min = "1900",
                              max = "2100"
                          })
        </div>

        <div class="mb-3">
            <label class="form-label">Màu sắc</label>

            @Html.TextBoxFor(m => m.CarColor,
                          new
                          {
                              @class = "form-control",
                              placeholder = "Đen, trắng, đỏ..."
                          })
        </div>

        <div class="mb-3">
            <label class="form-label">Động cơ</label>

            @Html.TextBoxFor(m => m.Engine,
                          new
                          {
                              @class = "form-control",
                              placeholder = "3.0L"
                          })
        </div>

        <div class="mb-3">
            <label class="form-label">Hộp số</label>

            @Html.TextBoxFor(m => m.Transmission,
                          new
                          {
                              @class = "form-control",
                              placeholder = "Tự động"
                          })
        </div>

        <div class="mb-3">
            <label class="form-label">Số lượng tồn kho</label>

            <input type="number"
                   name="quantity"
                   value="@ViewBag.Quantity"
                   min="0"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Link ảnh xe</label>

            @Html.TextBoxFor(m => m.ProductImage,
                          new
                          {
                              @class = "form-control",
                              placeholder = "https://example.com/car.jpg"
                          })

            @Html.ValidationMessageFor(
                          m => m.ProductImage, "",
                          new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">
                Hoặc chọn ảnh từ máy tính
            </label>

            <input type="file"
                   name="UploadImage"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" />

            @Html.ValidationMessage(
                          "UploadImage", "",
                          new { @class = "text-danger" })
        </div>

        if (!string.IsNullOrWhiteSpace(Model.ProductImage))
        {
            string imageUrl = Model.ProductImage;

            if (imageUrl.StartsWith("~/"))
            {
                imageUrl = Url.Content(imageUrl);
            }

            <div class="mb-3">
                <label class="form-label">Ảnh hiện tại</label>

                <div>
                    <img src="@imageUrl"
                         width="250"
                         class="img-thumbnail"
                         alt="@Model.ProductName" />
                </div>
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Mô tả xe</label>

            @Html.TextAreaFor(m => m.ProductDescription,
                          new
                          {
                              @class = "form-control",
                              rows = "5",
                              placeholder = "Nhập mô tả xe..."
                          })
        </div>

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary">
                Cập nhật
            </button>

            <a href="@Url.Action("Index", "Products",
                     new { area = "Admin" })"
               class="btn btn-secondary">
                Quay lại
            </a>
        </div>
    }
</div>
