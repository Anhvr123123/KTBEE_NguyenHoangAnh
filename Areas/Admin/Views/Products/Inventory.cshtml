
@model IEnumerable<KTBEE_NguyenHoangAnh.Models.Product>
@using System.Linq

@{
    ViewBag.Title = "Tồn kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Quản lý tồn kho xe</h2>
<hr />

<a href="@Url.Action("Index")"
   class="btn btn-secondary mb-3">
    Quay lại danh sách xe
</a>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Mã xe</th>
            <th>Tên xe</th>
            <th>Hãng</th>
            <th>Tồn kho</th>
            <th>Đã bán</th>
            <th>Trạng thái</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var detail = item.ProductDetails.FirstOrDefault();
            int quantity = detail != null ? detail.Quantity : 0;
            int sold = detail != null ? detail.QuantitySold : 0;

            <tr>
                <td>@item.ProductID</td>
                <td>@item.ProductName</td>
                <td>@item.Category.CategoryName</td>
                <td>@quantity</td>
                <td>@sold</td>

                <td>
                    @if (quantity > 0)
                    {
                        <span class="badge bg-success">Còn hàng</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Hết hàng</span>
                    }
                </td>

                <td>
                    <a href="@Url.Action("Edit", new { id = item.ProductID })"
                       class="btn btn-warning btn-sm">
                        Cập nhật
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
