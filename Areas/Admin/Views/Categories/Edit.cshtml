
@model KTBEE_NguyenHoangAnh.Models.Category

@{
    ViewBag.Title = "Sửa hãng xe";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Sửa thông tin hãng xe</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CategoryID)

    <div class="mb-3">
        <label class="form-label">Mã hãng</label>
        <input type="text"
               class="form-control"
               value="@Model.CategoryID"
               readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Tên hãng xe</label>

        @Html.TextBoxFor(m => m.CategoryName,
                 new { @class = "form-control" })

        @Html.ValidationMessageFor(m => m.CategoryName,
                 "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label class="form-label">Mô tả</label>

        @Html.TextAreaFor(m => m.Description,
                 new { @class = "form-control", rows = 4 })
    </div>

    <button type="submit" class="btn btn-primary">
        Cập nhật
    </button>

    <a href="@Url.Action("Index")"
       class="btn btn-secondary">
        Quay lại
    </a>
}
