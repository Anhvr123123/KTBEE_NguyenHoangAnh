@model KTBEE_NguyenHoangAnh.Models.Category

@{
    ViewBag.Title = "Thêm hãng xe";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <h2>Thêm hãng xe</h2>
                <p class="text-muted">
                    Nhập thông tin hãng xe mới.
                </p>

                @using (Html.BeginForm(
                    "Create",
                    "Categories",
                    new { area = "Admin" },
                    FormMethod.Post,
                    new { @class = "mt-4" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                             true,
                             "",
                             new { @class = "text-danger mb-3" })

                    <div class="mb-3">
                        @Html.LabelFor(
                                 m => m.CategoryName,
                                 "Tên hãng xe",
                                 new { @class = "form-label" })

                        @Html.TextBoxFor(
                                 m => m.CategoryName,
                                 new
                                 {
                                     @class = "form-control",
                                     placeholder = "Ví dụ: Ferrari",
                                     maxlength = "100",
                                     required = "required"
                                 })

                        @Html.ValidationMessageFor(
                                 m => m.CategoryName,
                                 "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(
                                 m => m.Description,
                                 "Mô tả",
                                 new { @class = "form-label" })

                        @Html.TextAreaFor(
                                 m => m.Description,
                                 new
                                 {
                                     @class = "form-control",
                                     rows = "4",
                                     maxlength = "500",
                                     placeholder = "Nhập mô tả hãng xe"
                                 })

                        @Html.ValidationMessageFor(
                                 m => m.Description,
                                 "",
                                 new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-success">
                            Lưu hãng xe
                        </button>

                        <a class="btn btn-outline-secondary"
                           href="@Url.Action("Index", "Categories",
                               new { area = "Admin" })">
                            Quay lại
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>