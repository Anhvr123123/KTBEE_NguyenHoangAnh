
@model IEnumerable<KTBEE_NguyenHoangAnh.Models.Category>

@{
    ViewBag.Title = "Quản lý hãng xe";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Quản lý hãng xe</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row mb-3">
    <div class="col-md-8">
        @using (Html.BeginForm("Index", "Categories",
            FormMethod.Get))
        {
            <div class="input-group">
                <input type="text"
                       name="searchTerm"
                       class="form-control"
                       placeholder="Nhập tên hãng xe..."
                       value="@ViewBag.SearchTerm" />

                <button type="submit"
                        class="btn btn-primary">
                    Tìm kiếm
                </button>
            </div>
        }
    </div>

    <div class="col-md-4 text-end">
        <a href="@Url.Action("Create", "Categories")"
           class="btn btn-success">
            Thêm hãng xe
        </a>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Mã hãng</th>
            <th>Tên hãng</th>
            <th>Mô tả</th>
            <th style="width:250px">Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryID</td>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>

                <td>
                    <a href="@Url.Action("Details", new { id = item.CategoryID })"
                       class="btn btn-info btn-sm text-white">
                        Chi tiết
                    </a>

                    <a href="@Url.Action("Edit", new { id = item.CategoryID })"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a href="@Url.Action("Delete", new { id = item.CategoryID })"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Không tìm thấy hãng xe nào.
    </div>
}
